# ==============================================================================
# Environment Configuration & Optional Foundation Model Authentication
# ==============================================================================
# Copy this file to '.env' and fill in your values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux / macOS)
#
# If neither TABPFN_TOKEN nor HF_TOKEN is configured, the pipeline logs a clear
# warning and executes cleanly using Random Forest and XGBoost without failing.
# ==============================================================================

# Option A: PriorLabs TabPFN Academic API Token (free for academic research)
# 1. Register at: https://ux.priorlabs.ai
# 2. Accept the academic/research license terms.
# 3. Copy your API Key from: https://ux.priorlabs.ai/account
TABPFN_TOKEN=your_tabpfn_api_key_here

# Option B: Hugging Face Access Token (accepted interchangeably if gated weights are authorized)
HF_TOKEN=your_hf_token_here
