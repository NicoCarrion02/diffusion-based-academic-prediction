# ==============================================================================
# Environment Configuration & Optional API Keys
# ==============================================================================
# Copy this file to '.env' and fill in your values:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux / macOS)
# ==============================================================================

# Optional: TabPFNv3 Foundation Model Token
# TabPFN requires a free academic license acceptance to download pre-trained weights.
# 1. Register a free account at: https://ux.priorlabs.ai
# 2. Accept the academic/research license terms.
# 3. Copy your API Key from: https://ux.priorlabs.ai/account
# 4. Paste your key below (100% free for non-commercial research):
TABPFN_TOKEN=your_tabpfn_api_key_here
