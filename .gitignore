# Git Ignore for Diffusion Academic Prediction Project

# Datasets and intermediate data
data/interim/*
!data/interim/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
legacy/data/
*.parquet
*.sas7bdat
*.SAS7BDAT
*.zip
*.csv.gz

# Trained models and checkpoints
models/*
!models/.gitkeep
legacy/models/
*.pkl
*.pt
*.pth
*.safetensors
*.onnx
checkpoints/

# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Experiment tracking & outputs
wandb/
runs/
*.log
other/